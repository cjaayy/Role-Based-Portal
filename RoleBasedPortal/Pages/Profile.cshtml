@page
@model RoleBasedPortal.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="portal-container">
    <aside class="sidebar">
        <div class="sidebar-header">
            <h3>Academic Portal</h3>
        </div>

        <div class="user-summary">
            <div class="user-icon">&#128100;</div>
            <h5>@Model.CurrentUser?.FullName</h5>
            <span>
                @Model.CurrentUser?.Role
            </span>
        </div>

        <nav class="sidebar-menu">
            <a asp-page="/Profile" class="menu-item active">
                Profile
            </a>

            @if (Model.CurrentUser?.Role == "Admin")
            {
                <a asp-page="/AddInstructor" class="menu-item">
                    Add Instructor
                </a>
            }

            @if (Model.CurrentUser?.Role == "Instructor")
            {
                <a asp-page="/AddStudent" class="menu-item">
                    Add Student
                </a>
            }

            <a asp-page="/Index" class="menu-item">
                Log Out
            </a>
        </nav>
    </aside>

    <main class="main-content">
        <div class="top-header">
            <div>
                <h2>Profile</h2>
                <p>Welcome to the Academic Portal</p>
            </div>
        </div>

        @if (Model.CurrentUser != null)
        {
            <div class="profile-card">
                <div class="profile-title">
                    <h3>Account Information</h3>
                </div>

                <div class="profile-information">
                    <div class="information-item">
                        <span class="label">Full Name</span>
                        <span class="value">@Model.CurrentUser.FullName</span>
                    </div>
                    <div class="information-item">
                        <span class="label">Username</span>
                        <span class="value">@Model.CurrentUser.Username</span>
                    </div>
                    <div class="information-item">
                        <span class="label">Access Level</span>
                        <span class="value">@Model.CurrentUser.Role</span>
                    </div>

                    @if (Model.CurrentUser.Role == "Instructor")
                    {
                        <div class="information-item">
                            <span class="label">Highest Degree</span>
                            <span class="value">@Model.CurrentUser.Degree</span>
                        </div>
                        <div class="information-item">
                            <span class="label">Department</span>
                            <span class="value">@Model.CurrentUser.Department</span>
                        </div>
                    }

                    @if (Model.CurrentUser.Role == "Student")
                    {
                        <div class="information-item">
                            <span class="label">Course</span>
                            <span class="value">@Model.CurrentUser.Course</span>
                        </div>
                        <div class="information-item">
                            <span class="label">Year Level</span>
                            <span class="value">@Model.CurrentUser.YearLevel</span>
                        </div>
                        <div class="information-item">
                            <span class="label">Section</span>
                            <span class="value">@Model.CurrentUser.Section</span>
                        </div>
                    }
                </div>
            </div>

            @if (Model.CurrentUser.Role == "Admin")
            {
                <div class="role-message admin-message">
                    <h4>Administrator Access</h4>
                    <p>
                        You have administrator privileges. You can manage instructors using the sidebar.
                    </p>
                </div>
            }

            @if (Model.CurrentUser.Role == "Instructor")
            {
                <div class="role-message instructor-message">
                    <h4>Instructor Access</h4>
                    <p>
                        You have instructor privileges. You can add new students using the sidebar.
                    </p>
                </div>
            }

            @if (Model.CurrentUser.Role == "Student")
            {
                <div class="role-message student-message">
                    <h4>Student Access</h4>
                    <p>
                        You can view your personal academic information.
                    </p>
                </div>
            }
        }
    </main>
</div>
